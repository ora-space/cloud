{
  "metadata": {
    "atespace": "ate-coding-poc",
    "name": "ora-coding-v3"
  },
  "workerSelector": {
    "matchLabels": {
      "workload": "python-coding"
    }
  },
  "containers": [
    {
      "name": "runtime",
      "image": "localhost:15001/python-coding:ora-v3@sha256:a679549659c0759a4fde9268c0d229dc4770e15288fcf5c69f427ad50bbd74ca",
      "readyz": {
        "httpGet": {
          "path": "/readyz",
          "port": 80
        }
      },
      "volumeMounts": [
        {
          "name": "workspace",
          "mountPath": "/workspace"
        }
      ]
    }
  ],
  "volumes": [
    {
      "name": "workspace",
      "durableDir": {}
    }
  ],
  "snapshotsConfig": {
    "onPause": "SNAPSHOT_CONTENT_SCOPE_DATA",
    "onCommit": "SNAPSHOT_CONTENT_SCOPE_DATA",
    "storageLocation": "gs://ate-snapshots/ate-coding-poc/"
  },
  "sandboxConfig": {
    "sandboxClass": "SANDBOX_CLASS_GVISOR",
    "configName": "gvisor-default"
  },
  "resources": {
    "limits": [
      {
        "name": "cpu",
        "quantity": "1"
      },
      {
        "name": "memory",
        "quantity": "768Mi"
      }
    ]
  }
}
