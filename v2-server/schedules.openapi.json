                }
              }
            }
          },
          "409": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleError"
                }
              }
            }
          },
          "428": {
            "description": "Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleError"
                }
              }
            }
          },
          "500": {
            "description": "Response",
            "content": {
              "application/json": {
