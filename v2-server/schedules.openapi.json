    "/api/v2/tenants/{tid}/schedule-resources": {
      "get": {
        "operationId": "getScheduleResources",
        "parameters": [
          {
            "in": "path",
            "name": "tid",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Shared execution resources",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleResources"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleError"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleError"
                }
              }
            }
          },
          "500": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleError"
                }
              }
            }
          },
          "503": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ScheduleTarget": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/ScheduleChatTarget"
          },
          {
            "$ref": "#/components/schemas/ScheduleWorkflowTarget"
          },
          {
            "$ref": "#/components/schemas/ScheduleLegacyTarget"
          }
        ]
      },
      "ScheduleRule": {
        "type": "object",
        "required": [
          "kind",
          "time",
          "days",
          "hours",
          "timezone"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "daily",
              "weekdays",
              "weekly",
              "hours"
            ]
          },
          "time": {
            "type": "string"
          },
          "days": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            }
          },
          "hours": {
            "type": "integer"
          },
          "timezone": {
            "type": "string"
          }
        }
      },
      "ScheduleInput": {
        "type": "object",
        "required": [
          "name",
          "projectId",
          "target",
          "rule"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "target": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ScheduleChatTarget"
              },
              {
                "$ref": "#/components/schemas/ScheduleWorkflowTarget"
              }
            ]
          },
          "rule": {
            "$ref": "#/components/schemas/ScheduleRule"
          }
        }
      },
      "ScheduleUpdate": {
        "type": "object",
        "required": [
          "name",
          "projectId",
          "target",
          "rule",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "target": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ScheduleChatTarget"
              },
              {
                "$ref": "#/components/schemas/ScheduleWorkflowTarget"
              }
            ]
          },
          "rule": {
            "$ref": "#/components/schemas/ScheduleRule"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "ScheduleEnabled": {
        "type": "object",
        "required": [
          "version",
          "enabled"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "ScheduleConfig": {
        "type": "object",
        "required": [
          "name",
          "projectId",
          "target",
          "rule",
          "id",
          "version",
          "enabled",
          "createdAt",
          "updatedAt",
          "runs"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "target": {
            "$ref": "#/components/schemas/ScheduleTarget"
          },
          "rule": {
            "$ref": "#/components/schemas/ScheduleRule"
          },
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "enabled": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "runs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "ScheduleList": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleConfig"
            }
          },
          "nextCursor": {
            "type": "string"
          }
        }
      },
      "ScheduleError": {
        "type": "object",
        "required": [
          "code",
          "params",
          "requestId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "ScheduleChatTarget": {
        "type": "object",
        "required": [
          "kind",
          "prompt",
          "agent",
          "model"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "chat"
            ]
          },
          "prompt": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "executorId": {
            "type": "string"
          }
        }
      },
      "ScheduleResources": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projects",
          "models",
          "executors",
          "workflows",
          "available"
        ],
        "properties": {
          "projects": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "description"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          },
          "executors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "agentName",
                "modelId"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "agentName": {
                  "type": "string"
                },
                "modelId": {
                  "type": "string"
                }
              }
            }
          },
          "workflows": {
            "type": "array",
            "description": "Workflows with a published version, each with the snapshot a schedule would freeze.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "version",
                "snapshotId"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "snapshotId": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "available": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "projects",
              "models",
              "executors",
              "workflows"
            ],
            "properties": {
              "projects": {
                "type": "boolean"
              },
              "models": {
                "type": "boolean"
              },
              "executors": {
                "type": "boolean"
              },
              "workflows": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "ScheduleLegacyTarget": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "workflow",
              "task"
            ]
          }
        },
        "additionalProperties": true,
        "description": "Read-only compatibility for previously stored references. Provider fields are preserved without interpretation; only the workflow target above can be written."
      },
      "ScheduleWorkflowTarget": {
        "type": "object",
        "required": [
          "kind",
          "workflowId",
          "snapshotId",
          "input"
        ],
        "additionalProperties": false,
        "description": "A workflow run in the schedule's project: one published snapshot of the workflow, frozen when the schedule is saved, and the kickoff input (may be empty). Each trigger creates and starts one run whose stable identity is the occurrence.",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "workflow"
            ]
          },
          "workflowId": {
            "type": "string",
            "format": "uuid"
          },
          "snapshotId": {
            "type": "string",
            "format": "uuid"
          },
          "input": {
            "type": "string",
            "maxLength": 32000
          }
        }
      }
    }
  }
}
