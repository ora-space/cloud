    "/api/v2/tenants/{tid}/schedule-configs/{id}/enabled": {
      "patch": {
        "operationId": "setScheduleConfigEnabled",
        "tags": [
          "scheduleConfigs"
        ],
        "parameters": [
          {
            "name": "tid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScheduleEnabled"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Response",
            "content": {
