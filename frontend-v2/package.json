{
  "name": "frontend-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "npm run api:check:members && npm run api:check:schedules && npm run api:check:squads && npm run api:check:chat && npm run api:check:workflows && npm run typecheck && npm run lint && npm run test && npm run build",
    "api:generate": "orval --config orval.config.ts",
    "api:generate:schedules": "orval --config orval.schedules.config.ts && npm run api:generate:schedule-runtime",
    "api:check:schedules": "npm run api:generate:schedules && git diff --exit-code -- src/features/schedules/api",
    "api:generate:squads": "orval --config orval.squads.config.ts",
    "api:check:squads": "npm run api:generate:squads && git diff --exit-code -- src/features/collaboration/api",
    "e2e": "playwright test",
    "api:generate:schedule-runtime": "orval --config orval.schedule-runtime.config.ts",
    "api:generate:chat": "orval --config orval.chat.config.ts",
    "api:check:chat": "npm run api:generate:chat && git diff --exit-code -- src/features/chat/api src/features/chat/projects-api",
    "api:generate:members": "orval --config orval.members.config.ts",
    "api:check:members": "npm run api:generate:members && git diff --exit-code -- src/features/settings/api",
    "api:generate:workflows": "orval --config orval.workflows.config.ts",
    "api:check:workflows": "npm run api:generate:workflows && git diff --exit-code -- src/lib/workflows/api"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-query": "^5.105.0",
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-bold": "^3.32.1",
    "@tiptap/extension-code": "^3.32.1",
    "@tiptap/extension-highlight": "^3.32.1",
    "@tiptap/extension-horizontal-rule": "^3.32.1",
    "@tiptap/extension-italic": "^3.32.1",
    "@tiptap/extension-link": "^3.32.1",
    "@tiptap/extension-list": "^3.32.1",
    "@tiptap/extension-strike": "^3.32.1",
    "@tiptap/extension-underline": "^3.32.1",
    "@tiptap/extensions": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@xyflow/react": "^12.12.0",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "i18next": "^26.5.11",
    "lucide-react": "^1.63.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.15.1",
    "react-router": "^8.5.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "orval": "^8.45.0",
    "oxlint": "^1.89.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
